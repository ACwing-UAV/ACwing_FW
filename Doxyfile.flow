# Doxygen: API reference of the ACwing Flow bridge firmware.
#   doxygen Doxyfile.flow    -> 03 - Docs/api/flow/index.html (not versioned)
# The CI builds it before the MkDocs site, which links to it (api/index.md).
PROJECT_NAME           = "ACwing Flow bridge firmware"
PROJECT_BRIEF          = "STM32C011: PMW3901 optical flow over SPI, I2C target 0x3B"
PROJECT_LOGO           = "03 - Docs/api/doxygen/acwing_mark_48.png"
OUTPUT_DIRECTORY       = "03 - Docs/api"
HTML_OUTPUT            = flow
CREATE_SUBDIRS         = NO
INPUT                  = "03 - Docs/api/doxygen/flow_main.md" \
                         "01 - FLOW_FW/Core/Inc" \
                         "01 - FLOW_FW/Core/Src"
USE_MDFILE_AS_MAINPAGE = "03 - Docs/api/doxygen/flow_main.md"
FILE_PATTERNS          = *.c *.h
RECURSIVE              = YES
EXCLUDE_PATTERNS       = */system_stm32c0xx.c
STRIP_FROM_PATH        = "01 - FLOW_FW/Core"
FULL_PATH_NAMES        = YES

OPTIMIZE_OUTPUT_FOR_C  = YES
JAVADOC_AUTOBRIEF      = YES
QT_AUTOBRIEF           = YES
EXTRACT_ALL            = YES
EXTRACT_STATIC         = YES
EXTRACT_PRIVATE        = YES
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES
SORT_MEMBER_DOCS       = NO
MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES
TYPEDEF_HIDES_STRUCT   = YES

ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
PREDEFINED             = STM32C011xx "__attribute__(x)="
SEARCH_INCLUDES        = NO

HAVE_DOT               = YES
DOT_IMAGE_FORMAT       = svg
INTERACTIVE_SVG        = YES
CALL_GRAPH             = YES
CALLER_GRAPH           = YES
INCLUDE_GRAPH          = YES
INCLUDED_BY_GRAPH      = YES
COLLABORATION_GRAPH    = YES
DIRECTORY_GRAPH        = YES
DOT_GRAPH_MAX_NODES    = 60
MAX_DOT_GRAPH_DEPTH    = 3

GENERATE_HTML          = YES
GENERATE_TREEVIEW      = YES
HTML_COLORSTYLE        = AUTO_LIGHT
SEARCHENGINE           = YES
USE_MATHJAX            = YES
MATHJAX_VERSION        = MathJax_3
GENERATE_LATEX         = NO

QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = NO
WARN_LOGFILE           = "03 - Docs/api/doxygen-flow-warnings.log"
